{
  "name": "model-dock",
  "version": "0.3.34",
  "description": "ModelDock — 配置一次，让模型连接你的工具。",
  "license": "MIT",
  "author": {
    "name": "ModelDock contributors",
    "email": "116045250+9Coco@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/9Coco/model-dock.git"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run icons:generate && npm run typecheck && vite build && npm run build:main",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:verify": "node scripts/verify-exe-icon.mjs",
    "verify:production": "node scripts/verify-production-build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "pack:win": "node scripts/pack-windows.mjs",
    "dist:win": "node scripts/pack-windows.mjs --portable",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "resedit": "^1.7.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "local.modeldock.desktop",
    "productName": "ModelDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/modeldock/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/modeldock/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "assets",
        "to": "icons",
        "filter": [
          "modeldock.png",
          "modeldock-tray.png",
          "modeldock.ico",
          "modeldock.svg"
        ]
      },
      {
        "from": "src/renderer/assets/tool-icons",
        "to": "licenses/tool-icons",
        "filter": [
          "LICENSE-*.txt",
          "NOTICE.md",
          "manifest.json"
        ]
      },
      {
        "from": "src/renderer/assets/material-symbols",
        "to": "licenses/material-symbols",
        "filter": [
          "LICENSE-*.txt",
          "NOTICE.md",
          "manifest.json"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/modeldock.ico",
      "signExecutable": false,
      "signAndEditExecutable": true
    },
    "linux": {
      "icon": "assets/modeldock.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
